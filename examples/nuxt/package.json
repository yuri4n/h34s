{
  "name": "@h34s/nuxt-example",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm run scala:full && node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node --enable-source-maps node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "pnpm run scala:full && node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "scala:fast": "h34s-scala dev",
    "scala:full": "h34s-scala build",
    "scala:watch": "h34s-scala watch",
    "dev:scala": "pnpm run scala:fast && pnpm run dev"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.2",
    "@nuxt/content": "^3.11.2",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@seahax/eslint-plugin-wrap": "^0.6.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/nuxt": "^14.2.1",
    "@yuri4n/h34s-nuxt": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^1.4.0",
    "jiti": "^2.6.1",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "nuxt-typed-router": "^4.0.2",
    "prettier": "^3.8.1",
    "remeda": "^2.33.6",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "h3": "1.15.4"
  },
  "description": "Unpublished Nuxt example consuming the h34s Scala.js toolbox"
}
