# Copy this file to .env (Git ignores it) and set your own local password.
# Nuxt development reads .env from this directory. Docker Compose reads it with
# `--env-file examples/nuxt/.env`. A production server (node .output/server/index.mjs) does not
# read .env: pass the variables in its environment.
#
# Nitro maps each NUXT_DATABASE_* variable to runtimeConfig.database (see nuxt.config.ts). The ZIO
# Notes example reads that config with ZRuntimeConfig. An empty password means none.
NUXT_DATABASE_HOST=127.0.0.1
NUXT_DATABASE_PORT=5432
NUXT_DATABASE_USER=h34s
NUXT_DATABASE_NAME=h34s
NUXT_DATABASE_PASSWORD=

# Optional: the Kyo example's greeting (runtimeConfig.greeting.salutation, default "Hello").
# NUXT_GREETING_SALUTATION=Hi

# Optional: include error causes and stack text in 500 responses outside Nuxt development.
# Use it only on a server that the public cannot reach.
# NUXT_H34S_DEBUG=true
