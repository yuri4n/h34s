{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "scala:types": "sbt -Dsbt.supershell=false -batch scalablytypedGenerate",
    "scala:fast": "sbt -Dsbt.supershell=false -batch fastLinkJS",
    "scala:full": "sbt -Dsbt.supershell=false -batch fullLinkJS",
    "dev:scala": "pnpm run scala:fast && nuxt dev",
    "build:scala": "pnpm run scala:full && nuxt build"
  },
  "dependencies": {
    "@nuxt/content": "3.6.2",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.15.0",
    "@nuxt/image": "1.10.0",
    "@nuxtjs/i18n": "9.5.6",
    "@nuxtjs/tailwindcss": "7.0.0-beta.0",
    "@vueuse/nuxt": "13.5.0",
    "better-sqlite3": "^12.2.0",
    "nuxt": "^4.0.1",
    "nuxt-typed-router": "4.0.1",
    "remeda": "^2.23.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@nuxt/eslint": "1.5.2",
    "@nuxt/test-utils": "3.19.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "eslint": "^9.30.1",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-remove-console": "^2.2.0"
  }
}
