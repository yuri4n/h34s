{
  "name": "h34s-workspace",
  "description": "h34s library development, package validation, and example commands",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "docs:check": "pnpm --dir docs check",
    "build": "pnpm run example:build",
    "dev": "pnpm run example:dev",
    "generate": "pnpm run example:generate",
    "preview": "pnpm run example:preview",
    "scala:fast": "h34s-scala dev --config examples/nuxt/h34s.build.config.mjs",
    "scala:full": "h34s-scala build --config examples/nuxt/h34s.build.config.mjs",
    "dev:scala": "pnpm run scala:fast && pnpm run dev",
    "build:scala": "pnpm run build",
    "scala:watch": "h34s-scala watch --config examples/nuxt/h34s.build.config.mjs",
    "test:tooling": "node --test scripts/*.test.mjs packages/nuxt/test/*.test.mjs",
    "test:package": "node scripts/check-npm-package.mjs && node scripts/check-npm-nuxt.mjs",
    "example:build": "pnpm --dir examples/nuxt run build",
    "example:dev": "pnpm --dir examples/nuxt run dev",
    "example:generate": "pnpm --dir examples/nuxt run generate",
    "example:preview": "pnpm --dir examples/nuxt run preview"
  },
  "devDependencies": {
    "@yuri4n/h34s-nuxt": "workspace:*",
    "nuxt": "^4.3.1"
  }
}
