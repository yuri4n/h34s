{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "pnpm run scala:full && nuxt build",
    "dev": "pnpm run scala:fast && nuxt dev",
    "generate": "pnpm run scala:full && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "scala:types": "pnpm run scala:facades",
    "scala:facades": "sbt -Dsbt.supershell=false -batch h3Ext/compile",
    "scala:fast": "sbt -Dsbt.supershell=false -batch nuxtsvr/nuxtDevLink",
    "scala:full": "sbt -Dsbt.supershell=false -batch nuxtsvr/nuxtProdLink",
    "scala:test": "sbt -Dsbt.supershell=false -batch test",
    "dev:scala": "pnpm run dev",
    "build:scala": "pnpm run build"
  },
  "dependencies": {
    "h3": "1.15.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.2",
    "@nuxt/content": "^3.11.2",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@seahax/eslint-plugin-wrap": "^0.6.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/nuxt": "^14.2.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^1.4.0",
    "jiti": "^2.6.1",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "nuxt-typed-router": "^4.0.2",
    "prettier": "^3.8.1",
    "remeda": "^2.33.6",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2",
    "zod": "^4.3.6"
  }
}
